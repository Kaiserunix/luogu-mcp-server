{
  "$schema": "https://json.schemastore.org/wrangler",
  "name": "luogu-mcp-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "luogu-mcp.ksrnyx.top",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
